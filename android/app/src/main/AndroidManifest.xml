<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Red: sincronización offline-first y API. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Cámara: escaneo de EAN y QR de etiquetas. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- USB host: impresión de etiquetas a Zebra por USB (OTG). No obligatorio
         para no excluir equipos sin OTG; el permiso USB se pide en runtime. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>

    <!-- Ubicación: GPS obligatorio del camión (escaneos, POD, telemetría). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Segundo plano: la telemetría del camión sigue con la app minimizada. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- Bluetooth: impresión ZPL a Zebra ZQ630 portátil. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Compatibilidad con Android 11 e inferiores. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>

    <!-- GPS en segundo plano mientras el chofer rueda (foreground service). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Notificaciones (Android 13+): push y servicio en primer plano. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Android 16+: notificación de ruta "promovida" (chip en la barra de
         estado / Now Bar), el equivalente Android a la isla dinámica. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>
    <!-- Isla de ruta propia (pastilla flotante arriba al centro) para Android
         8–15 y equipos sin Live Updates: requiere "Mostrar sobre otras apps",
         que el chofer activa desde Ajustes. Sin el permiso no se muestra. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- Inicio de sesión con huella / rostro (BiometricPrompt). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-feature android:name="android.hardware.fingerprint" android:required="false"/>

    <!-- Seguridad: sin backup (cola offline, tokens y fotos no salen del equipo) y
         solo HTTPS en release (network_security_config; debug/profile permiten
         http a 10.0.2.2/localhost). Ver docs/release.md. -->
    <application
        android:label="DisTrack"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Servicio en primer plano para la telemetría GPS del camión en ruta. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Widgets de la pantalla de inicio (WidgetsChannel + paquete widgets).
             exported="false" como en la guía oficial de App Widgets: el sistema
             (AppWidgetService, uid del sistema) entrega APPWIDGET_UPDATE igual a
             receivers no exportados, y así ninguna otra app puede mandarles
             broadcasts. Sin refresco periódico (updatePeriodMillis="0"). -->
        <receiver
            android:name=".widgets.NextDeliveryWidget"
            android:exported="false"
            android:label="@string/widget_next_delivery_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_delivery_info"/>
        </receiver>
        <receiver
            android:name=".widgets.RouteDayWidget"
            android:exported="false"
            android:label="@string/widget_route_day_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_route_day_info"/>
        </receiver>
        <receiver
            android:name=".widgets.PickingPendingWidget"
            android:exported="false"
            android:label="@string/widget_picking_pending_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_picking_pending_info"/>
        </receiver>
        <receiver
            android:name=".widgets.StoreReceptionsWidget"
            android:exported="false"
            android:label="@string/widget_store_receptions_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_store_receptions_info"/>
        </receiver>
        <receiver
            android:name=".widgets.SupervisorSummaryWidget"
            android:exported="false"
            android:label="@string/widget_supervisor_summary_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_supervisor_summary_info"/>
        </receiver>
        <receiver
            android:name=".widgets.QuickScanWidget"
            android:exported="false"
            android:label="@string/widget_quick_scan_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_scan_info"/>
        </receiver>

        <!-- Render con Skia (OpenGL) en Android en vez de Impeller. Los teléfonos
             de 1 GB (Android Go, GPUs Mali/PowerVR de gama baja) tienen drivers
             Vulkan inestables y con Impeller usan más memoria de GPU; Skia es el
             camino maduro ahí. Flutter 3.32 todavía lo soporta en Android. En
             iOS no aplica (iOS solo tiene Impeller). Para probar Impeller:
             value="true". Ver docs/rendimiento-y-pantallas.md. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Llamar al cliente desde la entrega en curso (marcador). -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- "Navegar": sin esto, desde Android 11 canLaunchUrl(geo:) da falso y
             siempre se abría el navegador en vez de la app de mapas. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
    </queries>
</manifest>
