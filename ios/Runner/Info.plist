<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>es</string>
		<key>CFBundleLocalizations</key>
		<array>
			<string>es</string>
		</array>
		<key>CFBundleDisplayName</key>
		<string>DisTrack</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>logistics_app</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<!-- App interna sin cifrado propio (solo HTTPS del sistema): evita la pregunta de
	     exportación en cada subida a TestFlight. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<!-- Permisos: textos en español, los ve el chofer/personal de tienda. -->
		<key>NSCameraUsageDescription</key>
		<string>La cámara se usa para escanear códigos de barras y etiquetas QR de los bultos, y para sacar las fotos de prueba de entrega.</string>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>La ubicación se usa para registrar dónde se hace cada escaneo y cada entrega.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>Mientras estás en ruta, la ubicación del camión se sigue enviando aunque la app quede en segundo plano, para que la central y el cliente vean el avance de la entrega.</string>
		<key>NSLocationAlwaysUsageDescription</key>
		<string>Mientras estás en ruta, la ubicación del camión se sigue enviando aunque la app quede en segundo plano.</string>
		<key>NSBluetoothAlwaysUsageDescription</key>
		<string>El Bluetooth se usa para conectar e imprimir etiquetas en la impresora Zebra portátil.</string>
		<key>NSBluetoothPeripheralUsageDescription</key>
		<string>El Bluetooth se usa para conectar e imprimir etiquetas en la impresora Zebra portátil.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Se usan tus fotos para adjuntar pruebas de entrega o de daños.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Se guardan las fotos de prueba de entrega o de daños que tomes.</string>
		<key>NSUserNotificationsUsageDescription</key>
		<string>Las notificaciones avisan de nuevas tareas, cambios de ruta y mensajes de la central.</string>
		<!-- Segundo plano: GPS del camión (location), push silencioso de tareas
	     (remote-notification) y sincronización de la cola offline (fetch/processing,
	     vía workmanager y flutter_foreground_task). -->
		<key>UIBackgroundModes</key>
		<array>
			<string>location</string>
			<string>remote-notification</string>
			<string>fetch</string>
			<string>processing</string>
		</array>
		<!-- BGTaskScheduler: el de sync se registra en AppDelegate.swift (kSyncTaskIdentifier)
	     y el código Dart de workmanager debe usar exactamente el mismo identificador. -->
		<key>BGTaskSchedulerPermittedIdentifiers</key>
		<array>
			<string>bo.com.dismac.logisticsApp.sync</string>
			<string>com.pravera.flutter_foreground_task.refresh</string>
		</array>
		<!-- url_launcher: canLaunchUrl de llamar al cliente y abrir la navegación. -->
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>tel</string>
			<string>comgooglemaps</string>
			<string>maps</string>
			<string>geo</string>
		</array>
		<!-- firebase_messaging necesita el swizzling del AppDelegate (token APNs y
	     entrega de mensajes); se deja explícito para que nadie lo desactive. -->
		<key>FirebaseAppDelegateProxyEnabled</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
